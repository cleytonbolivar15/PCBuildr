# PCBuildr Environment Configuration Template
# Copy this to .env and customize as needed

# Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# BACKEND_URL is computed from HOST:PORT, but can be overridden:
# BACKEND_URL=http://127.0.0.1:8000

# AI Provider (offline | openai | openrouter | groq)
# Default: offline - works without any API key
# Offline mode provides intelligent responses through structured logic
AI_PROVIDER=offline

# OpenAI Configuration (Optional)
# Uncomment and set your API key to use OpenAI for enhanced responses
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo

# OpenRouter Configuration (Optional)
# Uncomment and set your API key to use OpenRouter for more AI models
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-2-7b-chat

# Groq Configuration (Optional)
# Uncomment and set your API key to use Groq for faster inference
# GROQ_API_KEY=gsk-...
# GROQ_MODEL=mixtral-8x7b-32768

# Database Settings
DATABASE_PATH=./pcbuildr.db
USER_DATA_DIR=./userdata

# UI Settings
DEFAULT_LANGUAGE=es
DEFAULT_THEME=dark

# Debug Mode (true | false)
DEBUG=false
